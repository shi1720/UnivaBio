def save(name, rows):
    payload = {
        "schema_version": 1,
        "provenance": {
            "type": "original_synthetic",
            "contains_real_patient_data": False,
            "created_for": "Looplight / UnivaBio 2026",
            "authoring": "AI-assisted original synthetic examples, reviewed as engineering fixtures; no clinician annotation",
            "purpose": "Sentence topic classification, not medical advice or clinical validation",
            "split_policy": "Fixed authored split established before fitting; held-out set is never used for fitting or threshold selection",
        },
        "labels": LABELS,
        "examples": rows,
    }
    (HERE / name).write_text(json.dumps(payload, indent=2) + "\n")

if __name__ == "__main__":
    training = []
    for label, examples in TRAIN.items():
        for i, text in enumerate(examples):
            training.append({"id": f"train-{label}-{i+1:03}", "text": text, "label": label})
    heldout = []
    for label, examples in EVAL.items():
        for i, (text, tags) in enumerate(examples):
            heldout.append({"id": f"eval-{label}-{i+1:03}", "text": text, "label": label, "tags": tags})
    save("train.json", training)
    save("eval.json", heldout)
    print(f"Wrote {len(training)} training and {len(heldout)} held-out examples")

endstream
