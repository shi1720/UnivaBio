  .main-content {
    padding-top: 48px;
  }
  .journey {
    padding: 36px;
  }
  .loop-card {
    min-height: 330px;
  }
}
@media (max-width: 1150px) {
  .sidebar {
    width: 208px;
    padding-left: 14px;
    padding-right: 14px;
  }
  .main-shell {
    margin-left: 208px;
    width: calc(100% - 208px);
  }
  .main-content {
    padding: 28px 25px;
  }
  .topbar {
    padding: 0 25px;
  }
  h1 {
    font-size: 25px;
  }
  .primary-button {
    padding: 11px 13px;
  }
  .journey {
    padding: 24px;
  }
  .journey-graphic {
    width: 49%;
  }
  .journey-step small {
    max-width: 85px;
  }
  .loop-card {
    padding: 17px;
  }
  .detail-label {
    display: none;
  }
  .made-by {
    display: none;
  }
}
@media (max-width: 850px) {
  .sidebar {
    width: 78px;
    padding: 25px 10px;
  }
  .brand {
    font-size: 0;
    gap: 0;
    margin: 0 auto 36px;
  }
  .brand-mark {
    font-size: 27px;
  }
  .brand-dot,
  .workspace-label,
  .nav-item span,
  .side-note,
  .profile {
    display: none;
  }
  .nav-item {
    font-size: 0;
    justify-content: center;
    padding: 17px;
    gap: 0;
  }
  .main-shell {
    margin-left: 78px;
    width: calc(100% - 78px);
  }
  .page-heading {
    align-items: flex-start;
  }
  .page-heading h1 {
    max-width: 350px;
  }
  .journey-graphic {
    width: 50%;
  }
  .journey-step b {
    font-size: 12px;
  }
  .journey-step small {
    display: none;
  }
  .step-node {
    width: 55px;
    height: 55px;
  }
  .step-node.done {
    width: 43px;
    height: 43px;
    margin: 6px 0 22px;
  }
  .progress-path {
    top: 27px;
  }
  .journey h2 {
    font-size: 21px;
  }
  .board-grid {
    gap: 12px;
  }
  .loop-card {
    padding: 16px;
  }
  .loop-card h3 {
    font-size: 16px;
  }
  .card-date {
    font-size: 11px;
  }
  .card-top {
    margin-bottom: 13px;
  }
  .source-tag {
    font-size: 9px;
  }
  .page-heading p {
    max-width: 280px;
  }
}
@media (max-width: 640px) {
  .sidebar {
    position: relative;
    inset: auto;
    width: auto;
    height: 65px;
    padding: 0 18px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }
  .brand {
    margin: 0;
    font-size: 24px;
    gap: 8px;
  }
  .brand-mark {
    height: 30px;
    width: 27px;
  }
  .sidebar nav {
    display: flex;
  }
  .nav-item {
    padding: 12px;
    margin: 0 3px;
  }
  .app-shell {
    display: block;
  }
  .main-shell {
    margin: 0;
    width: 100%;
  }
  .topbar {
    height: 54px;
    padding: 0 20px;
    font-size: 12px;
  }
  .topbar > div {
    gap: 10px;
  }
  .demo-badge {
    font-size: 9px;
  }
  .topbar .text-button {
    font-size: 12px;
  }
  .main-content {
    padding: 27px 20px;
  }
  .page-heading {
    display: block;
    margin-bottom: 24px;
  }
  .page-heading h1 {
    font-size: 28px;
    max-width: 360px;
  }
  .page-heading p {
    max-width: none;
    font-size: 14px;
  }
  .page-heading .primary-button {
    margin-top: 18px;
  }
  .journey {
    display: block;
    padding: 23px;
  }
  .journey h2 {
    max-width: none;
  }
  .journey p br {
    display: none;
  }
  .journey-graphic {
    width: 100%;
    margin: 28px 0 0;
  }
  .journey-step small {
    display: block;
    max-width: 85px;
    font-size: 10px;
  }
  .journey-step b {
    font-size: 11px;
  }
  .progress-path {
    left: 40px;
    right: 44px;
  }
  .journey-link {
    margin-top: 12px;
  }
  .board-grid {
    grid-template-columns: 1fr;
  }
  .loop-card {
    min-height: 240px;
    padding: 22px;
  }
  .loop-card h3 {
    font-size: 20px;
  }
  .loop-card p {
    font-size: 14px;
  }
  .card-top {
    margin-bottom: 13px;
  }
  .card-date {
    font-size: 13px;
  }
  .status {
    font-size: 12px;
  }
  .source-tag {
    font-size: 11px;
  }
  .card-type {
    font-size: 13px;
  }
  .section-heading {
    align-items: flex-start;
    gap: 12px;
  }
  .section-heading p {
    font-size: 13px;
    max-width: 220px;
  }
  .section-heading .secondary-button {
    padding: 9px;
    font-size: 12px;
  }
  .detail-preview {
    display: block;
    padding: 19px;
  }
  .detail-preview > .text-button {
    margin-top: 12px;
  }
  .bottom-note {
    align-items: flex-start;
    line-height: 1.6;
    font-size: 11px;
  }
}
/* Product controls and secondary surfaces share the same spacing, contrast and focus rules. */
.nav-item .nav-text {
  margin: 0;
  color: inherit;
  font-size: 14px;
}
.nav-item .nav-count {
  margin-left: auto;
}
.nav-item span {
  display: inline;
}
.nav-item {
  gap: 12px;
}
.skip-link {
  position: fixed;
  top: -100px;
  left: 20px;
  z-index: 100;
  background: white;
  padding: 12px;
  border-radius: 6px;
}
.skip-link:focus {
  top: 10px;
}
.space-switch {
  display: flex;
  align-items: center;
  gap: 14px;
  background: none;
  border: 0;
  color: #728097;
  font-size: 14px;
  padding: 0;
  text-align: left;
}
.space-switch strong {
  font-weight: 500;
  color: #384c62;
}
.top-account {
  display: flex;
  gap: 7px;
  align-items: center;
  border: 0;
  background: none;
  color: #466458;
  font-size: 13px;
}
.board-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin: 0 0 20px;
}
.filter-tabs {
  display: flex;
  align-items: center;
  gap: 5px;
  flex-wrap: wrap;
}
.filter-tabs button {
  border: 0;
  background: none;
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 13px;
  color: #66788e;
  border-radius: 7px;
  padding: 8px 10px;
}
.filter-tabs button.active {
  background: #e5ebf9;
  color: #254eaf;
  font-weight: 600;
}
.filter-tabs button span {
  font-size: 11px;
  font-weight: 400;
  background: #ffffff78;
  padding: 0 5px;
  border-radius: 4px;
}
.search-field {
  display: flex;
  align-items: center;
  gap: 9px;
  background: white;
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 0 12px;
  color: #8290a3;
}
.search-field input {
  background: transparent;
  border: 0;
  margin: 0;
  padding: 10px 0;
  min-width: 0;
  box-shadow: none !important;
  font-size: 14px;
  width: 100%;
}
.search-field.compact {
  width: 185px;
}
.search-field.compact input {
  font-size: 12px;
  padding: 8px 0;
}
.search-field input:focus-visible {
  outline: none;
}
.search-field:focus-within {
  outline: 3px solid #9ab2f0;
  outline-offset: 2px;
}
.coverage-note {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  margin-top: 14px;
  background: none;
  border: 0;
  padding: 10px 2px;
  color: #60718a;
  font-size: 13px;
  width: 100%;
  text-align: left;
}
.coverage-note span {
  display: flex;
  align-items: center;
  gap: 9px;
  flex-wrap: wrap;
}
.coverage-note strong {
  font-weight: 500;
  color: #3654a1;
}
.coverage-note svg {
  flex-shrink: 0;
}
.card-owner {
  display: flex;
  gap: 7px;
  align-items: center;
  font-size: 12px;
  color: #627089;
  margin: -6px 0 14px;
}
.card-owner > span {
  display: grid;
  place-items: center;
  border-radius: 50%;
  height: 20px;
  width: 20px;
  background: #edf1f8;
  font-size: 10px;
}
.card-date.overdue {
  color: #9c592c;
}
.loop-card.suggestion {
  border-top: 3px solid #d8b46c;
}
.loop-card {
  min-height: 324px;
}
.status {
  font-size: 12px;
}
.source-tag {
  font-size: 11px;
}
.card-date {
  font-size: 13px;
}
.card-type {
  font-size: 13px;
}
.detail-preview blockquote {
  font-size: 14px;
}
.detail-preview p {
  font-size: 12px;
}
.detail-preview > .text-button {
  font-size: 13px;
}
.bottom-note {
  font-size: 12px;
  line-height: 1.6;
}
.made-by {
  font-size: 12px;
}
.eyebrow {
  font-size: 12px;
}
.journey-step small {
  font-size: 12px;
}
.journey-step b {
  font-size: 14px;
}
.journey-link {
  font-size: 14px;
}
.demo-footer {
  display: flex;
  gap: 16px;
  align-items: center;
  justify-content: space-between;
  border-top: 1px solid #e1e7ef;
  margin-top: 16px;
  padding-top: 15px;
  color: #7b879b;
  font-size: 12px;
}
.green {
  color: #3c6b49;
  background: #e8f5e9;
}
.full-width {
  width: 100%;
}
.icon-button {
  display: inline-grid;
  place-items: center;
  border: 0;
  background: transparent;
  width: 34px;
  height: 34px;
  border-radius: 6px;
  color: #69788f;
  padding: 0;
}
.icon-button:hover {
  background: #eef2f7;
}
.modal {
  border: 1px solid #d9e2ee;
  border-radius: 17px;
  padding: 0;
  width: min(590px, calc(100vw - 36px));
  max-height: calc(100dvh - 48px);
  box-shadow: 0 30px 100px #0c1f3538;
  color: var(--foreground);
  background: white;
  position: fixed;
  margin: auto;
  overflow: auto;
}
.modal.wide {
  width: min(810px, calc(100vw - 36px));
}
.modal.drawer {
  width: min(610px, 100vw);
  height: 100dvh;
  max-height: 100dvh;
  margin: 0 0 0 auto;
  border-radius: 15px 0 0 15px;
  border-right: 0;
  top: 0;
  bottom: 0;
}
.modal::backdrop {
  background: #0c1a2c73;
  backdrop-filter: blur(3px);
}
.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid #e3e8ef;
  padding: 20px 26px;
  gap: 20px;
  position: sticky;
  top: 0;
  background: #fff;
  z-index: 5;
}
.modal-header h2 {
  font-size: 20px;
  font-weight: 600;
  letter-spacing: -0.6px;
  margin: 0;
}
.modal-body {
  padding: 24px 27px;
}
.modal-body > .lead {
  font-size: 16px;
  color: #62738a;
  margin: 0 0 20px;
}
.modal-footer {
  position: sticky;
  bottom: 0;
  background: #fff;
  border-top: 1px solid #e2e7ed;
  padding: 17px 27px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
}
.modal-footer > .muted {
  font-size: 13px;
}
.modal-body h4 {
  font-size: 16px;
  letter-spacing: -0.15px;
  margin: 23px 0 10px;
}
.modal-body p {
  font-size: 14px;
  line-height: 1.7;
}
.muted {
  color: #78879a;
}
.notice {
  display: flex;
  gap: 12px;
  align-items: flex-start;
  border: 1px solid transparent;
  border-radius: 9px;
  padding: 14px 16px;
  margin: 15px 0 20px;
  font-size: 14px;
  line-height: 1.65;
}
.notice svg {
  flex-shrink: 0;
  margin-top: 3px;
}
.notice p {
  margin: 0;
  font-size: 14px;
}
.notice ul {
  font-size: 14px;
  margin: 7px 0;
  padding-left: 18px;
  line-height: 1.65;
}
.notice strong {
  font-weight: 600;
}
.notice.neutral {
  background: #f0f4fa;
  color: #4c627b;
  border-color: #e1e8f2;
}
.notice.warning {
  background: #fff7e8;
  color: #886529;
  border-color: #eedcb8;
}
.notice.error {
  background: #fff0ee;
  color: #a13f39;
  border-color: #f3d4cf;
}
.notice-symbol {
  font-size: 13px;
  border: 1px solid #a58346;
  border-radius: 50%;
  display: grid;
  place-items: center;
  width: 18px;
  height: 18px;
  flex-shrink: 0;
  margin-top: 3px;
}
.notice.warning p {
  font-size: 13px;
  margin-top: 8px;
}
.notice.error > .text-button {
  margin-left: auto;
  color: inherit;
}
.error-text {
  color: #a13f39;
}
.sample-options {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin: 20px 0 25px;
}
.sample-button {
  display: flex;
  gap: 12px;
  align-items: center;
  text-align: left;
  border: 1px solid #dce4f0;
  background: #f9fbff;
  border-radius: 10px;
  padding: 14px;
  color: #345480;
  font-size: 14px;
}
.sample-button:hover {
  background: #eef4ff;
  border-color: #bccbed;
}
.sample-button > span {
  flex: 1;
}
.sample-button small {
  display: block;
  color: #7e8da2;
  font-size: 12px;
  margin-top: 3px;
}
.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 17px;
}
label {
  display: block;
  font-size: 14px;
  font-weight: 500;
  color: #3b5068;
  margin-bottom: 17px;
}
label small,
.field-help {
  display: block;
  font-size: 12px !important;
  line-height: 1.65;
  color: #74869b;
  font-weight: 400;
  margin: 6px 0 14px;
}
.field-help {
  margin: 8px 0 17px;
}
.field-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14px;
  margin-bottom: 8px;
}
.field-heading label {
  margin: 0;
}
.field-heading .text-button {
  font-size: 13px;
}
input,
textarea,
select {
  font: inherit;
  font-size: 14px;
  color: #29425d;
  border: 1px solid #d2dce9;
  border-radius: 7px;
  background: #fff;
  padding: 10px 12px;
  width: 100%;
  line-height: 1.6;
  margin-top: 6px;
  box-shadow: 0 1px 2px #122c4310;
}
input::placeholder,
textarea::placeholder {
  color: #90a0b2;
}
textarea {
  resize: vertical;
  min-height: 80px;
}
select {
  appearance: auto;
}
input[type="checkbox"] {
  width: 17px;
  height: 17px;
  accent-color: #315bdb;
  margin: 3px 0 0;
  flex-shrink: 0;
  padding: 0;
  box-shadow: none;
}
.checkbox-label {
  display: flex;
  gap: 11px;
  align-items: flex-start;
  font-weight: 400;
  line-height: 1.65;
  font-size: 14px;
  margin: 18px 0;
}
.field-meta {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  font-size: 11px;
  color: #8190a3;
  margin-top: 7px;
}
.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}
.detail-status {
  margin-bottom: 15px;
}
.detail-title {
  font-size: 26px !important;
  letter-spacing: -0.8px;
  line-height: 1.3;
  margin: 0 0 21px;
  font-weight: 550;
}
.source-evidence {
  background: #f2f5fa;
  border: 1px solid #dfe7f1;
  border-left: 3px solid #7293de;
  padding: 16px;
  border-radius: 8px;
}
.source-evidence > div {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #6f8199;
  font-size: 10px;
  letter-spacing: 1px;
}
.source-evidence .text-button {
  font-size: 12px;
  letter-spacing: 0;
  margin-left: auto;
}
.source-evidence blockquote {
  font-size: 16px;
  line-height: 1.7;
  margin: 11px 0;
  color: #3c506b;
}
.source-evidence > p {
  font-size: 12px;
  margin: 0;
  color: #7a8ba2;
}
.tab-row {
  display: flex;
  gap: 23px;
  border-bottom: 1px solid #e1e7ee;
  margin-top: 23px;
}
.tab-row > button {
  border: 0;
  border-bottom: 2px solid transparent;
  background: none;
  font-size: 14px;
  color: #728397;
  padding: 12px 0;
}
.tab-row > button.active {
  color: #315bdb;
  border-color: #315bdb;
}
.tab-content {
  padding-top: 4px;
}
.source-facts {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}
.source-facts span {
  display: block;
  font-size: 12px;
  color: #7b8da2;
}
.source-facts strong {
  display: block;
  margin-top: 5px;
  font-size: 14px;
  font-weight: 500;
}
.questions-block {
  border-left: 2px solid #d7e2f5;
  padding: 0 0 0 16px;
  margin: 23px 0;
}
.questions-block h4 {
  display: flex;
  align-items: center;
  gap: 9px;
}
.questions-block ul {
  padding-left: 18px;
  color: #526b87;
  font-size: 14px;
  line-height: 1.7;
}
.questions-block li {
  margin: 8px 0;
}
.button-row {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
  margin: 16px 0;
}
.close-form {
  border-top: 1px solid #e1e7ef;
  margin-top: 24px;
  padding-top: 2px;
}
.progress-steps {
  display: flex;
  justify-content: space-between;
  gap: 8px;
  margin: 20px 0;
}
.progress-steps > span {
  font-size: 12px;
  color: #8091a6;
  padding-bottom: 8px;
  border-bottom: 2px solid #dfe6f0;
  display: flex;
  gap: 5px;
  align-items: center;
  flex: 1;
}
.progress-steps > span.complete {
  color: #476d42;
  border-color: #7cab6f;
}
.completion-record {
  background: #edf6ed;
  border-radius: 10px;
  padding: 21px;
  margin: 20px 0;
  color: #365936;
}
.completion-record h4 {
  margin-top: 9px;
}
.completion-record small {
  font-size: 12px;
  color: #668066;
}
.completion-record dl {
  display: grid;
  grid-template-columns: 135px 1fr;
  gap: 8px;
  font-size: 13px;
}
.completion-record dt {
  color: #658066;
}
.completion-record dd {
  margin: 0;
}
.history-list {
  padding-top: 24px;
}
.history-item {
  display: flex;
  gap: 18px;
  position: relative;
  padding: 0 0 25px;
}
.history-item:not(:last-child):before {
  content: "";
  position: absolute;
  left: 5px;
  top: 16px;
  bottom: 0;
  width: 1px;
  background: #d9e3ef;
}
.history-dot {
  height: 11px;
  width: 11px;
  border: 2px solid #9fb6dc;
  border-radius: 50%;
  margin-top: 6px;
  flex-shrink: 0;
}
.history-item strong {
  font-weight: 500;
  font-size: 14px;
}
.history-item p {
  font-size: 13px;
  color: #657991;
  margin: 5px 0 8px;
  overflow-wrap: anywhere;
}
.history-item small {
  color: #95a1b2;
  font-size: 12px;
}
.source-summary {
  display: flex;
  gap: 16px;
  align-items: center;
  padding: 22px 24px;
  background: white;
  border: 1px solid #dbe4ed;
  border-radius: 12px;
  margin-bottom: 20px;
}
.source-summary h2 {
  font-size: 18px;
  margin: 0 0 5px;
  font-weight: 500;
}
.source-summary p {
  font-size: 13px;
  color: #7c8ca0;
  margin: 0;
}
.source-complete {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 7px;
  font-size: 12px;
  color: #5d7753;
}
.source-toolbar {
  display: flex;
  gap: 16px;
  align-items: center;
  margin: 24px 0 17px;
}
.source-toolbar .search-field {
  flex: 1;
}
.source-toolbar select {
  width: auto;
  margin: 0;
  font-size: 13px;
}
.source-sentences {
  background: #fff;
  border: 1px solid #dce4ec;
  border-radius: 12px;
  overflow: hidden;
}
.source-sentence {
  display: flex;
  gap: 22px;
  border-bottom: 1px solid #e9edf4;
  padding: 21px 25px;
  scroll-margin-top: 22px;
}
.source-sentence:last-child {
  border: 0;
}
.source-sentence.highlighted {
  background: #edf3ff;
  box-shadow: inset 4px 0 #5280e5;
}
.sentence-number {
  font-size: 12px;
  color: #8b9ab0;
  padding-top: 5px;
  width: 25px;
  flex-shrink: 0;
}
.sentence-body {
  flex: 1;
  min-width: 0;
}
.sentence-label {
  font-size: 11px;
  letter-spacing: 0.6px;
  text-transform: uppercase;
  color: #7a8ca3;
}
.sentence-body .verbatim {
  font-size: 16px;
  line-height: 1.65;
  margin: 7px 0 9px;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
.sentence-body .sentence-reason {
  font-size: 12px;
  color: #7a8ea5;
  margin: 0;
}
.sentence-actions {
  display: flex;
  gap: 20px;
  margin-top: 10px;
  flex-wrap: wrap;
}
.sentence-actions .text-button {
  font-size: 12px;
}
.manual-form {
  background: #f1f5fc;
  padding: 19px;
  border-radius: 8px;
  margin-top: 18px;
}
.raw-source {
  margin: 23px 0;
  background: #edf2f8;
  border-radius: 9px;
  padding: 17px 20px;
  color: #617892;
  font-size: 14px;
}
.raw-source summary {
  cursor: pointer;
}
.raw-source pre {
  white-space: pre-wrap;
  word-break: break-word;
  font:
    14px/1.8 Arial,
    Helvetica,
    sans-serif;
  color: #4d6481;
}
.empty-state {
  padding: 45px 24px;
  text-align: center;
  color: #74859d;
  background: #fff;
  border: 1px dashed #ccd8e8;
  border-radius: 12px;
  margin-top: 20px;
}
.empty-state > svg {
  margin: 0 auto 15px;
  color: #a3b5d0;
}
.empty-state h3 {
  font-size: 19px;
  color: #3a516e;
  margin: 0 0 10px;
  font-weight: 500;
}
.empty-state p {
  font-size: 14px;
  max-width: 450px;
  margin: 0 auto 18px;
}
.welcome-state {
  padding: 52px 35px 30px;
  max-width: 700px;
  margin: 0 auto;
  text-align: center;
}
.welcome-state > .type-icon {
  height: 62px;
  width: 62px;
  margin: 0 auto 24px;
}
.welcome-state h1 {
  font-size: 36px;
}
.welcome-state > p {
  font-size: 17px;
  color: #677d97;
  line-height: 1.7;
  margin: 18px auto 27px;
  max-width: 540px;
}
.welcome-state > .text-button {
  display: flex;
  justify-content: center;
  margin: 18px 0 35px;
}
.welcome-state .notice {
  text-align: left;
}
.loading-state {
  border: 0;
  background: transparent;
  padding-top: 150px;
}
.loading-state h1 {
  font-size: 24px;
}
.evidence-intro {
  display: grid;
  grid-template-columns: 1.45fr 1fr;
  gap: 50px;
  background: #eaf0fb;
  border: 1px solid #d8e3f6;
  padding: 28px;
  border-radius: 14px;
  margin-bottom: 24px;
}
.evidence-intro h2 {
  font-size: 25px;
  font-weight: 500;
  line-height: 1.35;
  letter-spacing: -0.55px;
  margin: 0 0 13px;
}
.evidence-intro p {
  font-size: 14px;
  color: #607593;
  line-height: 1.7;
  margin: 8px 0;
}
.model-recipe {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10px;
  font-size: 13px;
  color: #345c9a;
}
.model-recipe > svg {
  transform: rotate(90deg);
  color: #8ba5d1;
}
.metrics-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  background: white;
  border: 1px solid #dee5ee;
  border-radius: 13px;
  padding: 25px 0;
  margin-bottom: 22px;
}
.metrics-row > div {
  padding: 0 25px;
  border-right: 1px solid #e4eaf2;
}
.metrics-row > div:last-child {
  border: 0;
}
.metrics-row strong {
  font-size: 42px;
  font-weight: 500;
  letter-spacing: -1.5px;
  color: #315bdb;
}
.metrics-row strong > span {
  font-size: 18px;
  font-weight: 400;
  letter-spacing: 0;
  margin-left: 4px;
}
.metrics-row h3 {
  font-size: 15px;
  font-weight: 500;
  margin: 9px 0 5px;
}
.metrics-row p {
  font-size: 13px;
  color: #75869d;
  line-height: 1.65;
  margin: 0;
}
.live-lab {
  background: white;
  border: 1px solid #dce4ee;
  border-radius: 13px;
  padding: 28px;
  margin: 28px 0;
}
.live-lab h2 {
  font-size: 24px;
  font-weight: 500;
  letter-spacing: -0.5px;
  margin: 0;
}
.live-lab > div > p,
.evidence-section > p {
  font-size: 14px;
  line-height: 1.8;
  color: #71849c;
}
.live-lab > label {
  margin-top: 23px;
}
.prediction-summary {
  display: flex;
  align-items: center;
  gap: 15px;
  flex-wrap: wrap;
  margin: 21px 0;
}
.prediction-summary > strong {
  font-size: 14px;
  font-weight: 500;
}
.prediction-summary > span:last-child {
  color: #8695aa;
  font-size: 12px;
}
.score-bars {
  display: flex;
  flex-direction: column;
  gap: 12px;
  max-width: 580px;
  margin: 20px 0 25px;
}
.score-bars > div {
  display: grid;
  grid-template-columns: 115px 1fr 46px;
  gap: 12px;
  align-items: center;
  font-size: 13px;
  color: #667d98;
}
.score-bars > div > div {
  background: #edf2f9;
  height: 8px;
  border-radius: 5px;
  overflow: hidden;
}
.score-bars > div > div > span {
  height: 100%;
  display: block;
  background: #7393e5;
  border-radius: 5px;
  transition: width 0.2s;
}
.evidence-section {
  margin: 35px 0;
}
.evidence-section h2 {
  font-size: 23px;
  letter-spacing: -0.5px;
  font-weight: 500;
  margin-bottom: 12px;
}
.table-scroll {
  overflow-x: auto;
  background: white;
  border: 1px solid #dce5ef;
  border-radius: 10px;
  margin: 19px 0;
}
.confusion-table {
  border-collapse: collapse;
  width: 100%;
  font-size: 13px;
  min-width: 580px;
}
.confusion-table caption {
  text-align: left;
  font-size: 12px;
  color: #7c8da5;
  padding: 15px 20px;
  border-bottom: 1px solid #e5eaf2;
}
.confusion-table th {
  font-weight: 500;
  background: #f5f8fc;
  color: #667e9b;
}
.confusion-table td,
.confusion-table th {
  padding: 14px;
  border-bottom: 1px solid #e7edf4;
  text-align: center;
}
.confusion-table th:first-child {
  text-align: left;
  padding-left: 20px;
}
.confusion-table td.diagonal {
  background: #eff7e8;
  color: #496f36;
  font-weight: 600;
}
.confusion-table tr:last-child > * {
  border-bottom: 0;
}
.reference-list {
  background: white;
  border: 1px solid #dce4ed;
  border-radius: 12px;
  overflow: hidden;
}
.reference-list a {
  display: flex;
  gap: 20px;
  justify-content: space-between;
  align-items: center;
  padding: 20px 22px;
  border-bottom: 1px solid #e5eaf1;
}
.reference-list a:last-child {
  border: 0;
}
.reference-list a:hover {
  background: #f6f9fe;
}
.reference-list strong {
  font-size: 15px;
  font-weight: 500;
}
.reference-list small {
  display: block;
  font-size: 13px;
  color: #7b8fa8;
  margin-top: 6px;
}
.reference-list svg {
  flex-shrink: 0;
  color: #728dc1;
}
.limits-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 30px;
  margin: 30px 0;
}
.limits-grid h3 {
  font-size: 17px;
  font-weight: 500;
}
.limits-grid ul {
  padding-left: 18px;
  font-size: 14px;
  color: #6d819b;
  line-height: 1.8;
}
.limits-grid li {
  margin-bottom: 6px;
}
.export-toolbar {
  display: flex;
  gap: 9px;
  flex-wrap: wrap;
}
.brief-document {
  background: white;
  border: 1px solid #d9e2ed;
  padding: 29px;
  margin-top: 25px;
  color: #29405c;
}
.brief-brand {
  font-size: 24px;
  font-weight: 700;
  letter-spacing: -1px;
  color: #102238;
  margin-bottom: 22px;
}
.brief-brand > span {
  font-size: 10px;
  font-weight: 400;
  color: #788ba4;
  letter-spacing: 1.3px;
  margin-left: 12px;
}
.brief-document h2 {
  font-size: 26px;
  line-height: 1.25;
  margin: 0 0 8px;
}
.brief-document > p {
  color: #7b8da4;
  font-size: 12px;
}
.brief-caveat {
  border-left: 2px solid #c8d3e3;
  padding: 8px 12px;
  color: #73879f;
  font-size: 12px;
  margin: 20px 0;
}
.brief-item {
  border-top: 1px solid #e3e9f1;
  padding: 18px 0;
  break-inside: avoid;
}
.brief-item h3 {
  font-size: 17px;
  line-height: 1.5;
  margin: 0 0 9px;
}
.brief-item p {
  font-size: 12px;
  color: #627b98;
}
.brief-item blockquote {
  font-size: 13px;
  color: #48678d;
  margin: 10px 0;
  background: #f3f6fa;
  padding: 11px 13px;
}
.brief-item ul {
  font-size: 12px;
  color: #70849e;
  padding-left: 17px;
  line-height: 1.8;
}
.brief-document > footer {
  font-size: 10px;
  color: #8a9ab0;
  border-top: 1px solid #e2e8f1;
  padding-top: 17px;
}
.space-list {
  margin: 20px 0;
}
.space-option {
  display: flex;
  align-items: center;
  text-align: left;
  width: 100%;
  gap: 14px;
  background: white;
  border: 1px solid #dfe6ef;
  border-radius: 9px;
  padding: 16px;
  margin-bottom: 10px;
  color: #425e7f;
}
.space-option.active {
  border-color: #7f9de0;
  background: #f4f7ff;
}
.space-option > span:nth-child(2) {
  flex: 1;
}
.space-option strong {
  font-weight: 500;
  font-size: 16px;
}
.space-option small {
  display: block;
  font-size: 12px;
  color: #8496ad;
  margin-top: 3px;
}
.account-heading {
  text-align: center;
  border-bottom: 1px solid #e1e8ef;
  padding-bottom: 23px;
}
.account-heading > svg {
  color: #6e91c9;
  margin: 0 auto 12px;
}
.account-heading h3 {
  font-weight: 500;
  font-size: 21px;
  letter-spacing: -0.3px;
  margin: 0;
}
.account-heading p {
  color: #8193aa;
  font-size: 13px;
  overflow-wrap: anywhere;
}
.privacy-copy {
  color: #647c98;
  font-size: 14px;
  line-height: 1.7;
}
.privacy-copy h4 {
  color: #314e71;
}
.delete-section {
  margin: 22px 0 10px;
  padding-top: 20px;
  border-top: 1px solid #e4e9ef;
}
.delete-section p {
  color: #8c6159;
}
.danger {
  color: #a5554b;
}
.danger-button {
  background: #ae493f;
  color: white;
  border: 0;
  border-radius: 7px;
  padding: 11px 17px;
  font-size: 14px;
}
.account-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  margin-top: 25px;
}
.account-bottom > span {
  font-size: 12px;
  color: #8b9ab0;
}
.toast {
  position: fixed;
  z-index: 100;
  left: 50%;
  bottom: 24px;
  transform: translateX(-50%);
  max-width: min(620px, calc(100vw - 32px));
  background: #132b43;
  color: #fff;
  border: 1px solid #37516e;
  border-radius: 10px;
  padding: 13px 14px 13px 18px;
  box-shadow: 0 6px 24px #11283d30;
  display: flex;
  gap: 10px;
  align-items: center;
  font-size: 14px;
}
.toast > svg {
  flex-shrink: 0;
  color: #c7f578;
}
.toast .icon-button {
  color: #9eb3ca;
  flex-shrink: 0;
}
.spin {
  animation: spin 1s linear infinite;
}
@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
@media (prefers-reduced-motion: reduce) {
  *,
  *:before,
  *:after {
    animation: none !important;
    transition: none !important;
    scroll-behavior: auto !important;
  }
}
@media (max-width: 1150px) {
  .board-toolbar {
    flex-wrap: wrap;
  }
  .journey-step small {
    max-width: 105px;
  }
  .metrics-row strong {
    font-size: 34px;
  }
  .evidence-intro {
    gap: 25px;
  }
  .journey-graphic {
    gap: 10px;
  }
  .source-complete {
    display: none;
  }
}
@media (max-width: 850px) {
  .nav-item .nav-text,
  .nav-item .nav-count {
    display: none;
  }
  .nav-item {
    gap: 0;
  }
  .journey-step b {
    font-size: 12px;
  }
  .journey-step small {
    display: none;
  }
  .evidence-intro {
    grid-template-columns: 1fr;
  }
  .model-recipe {
    flex-direction: row;
    font-size: 12px;
  }
  .model-recipe > svg {
    transform: none;
    flex-shrink: 0;
  }
  .metrics-row > div {
    padding: 0 18px;
  }
  .source-summary {
    padding: 19px;
  }
  .evidence-section h2 {
    font-size: 21px;
  }
  .made-by {
    display: none;
  }
}
@media (max-width: 640px) {
  .top-account span {
    display: none;
  }
  .space-switch > span:first-child {
    display: none;
  }
  .space-switch {
    gap: 7px;
    max-width: 170px;
    font-size: 13px;
  }
  .space-switch strong {
    max-width: 130px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .topbar > div {
    gap: 8px;
  }
  .topbar .text-button {
    font-size: 12px;
  }
  .journey-step small {
    display: block;
    font-size: 11px;
    max-width: 95px;
  }
  .journey-step b {
    font-size: 12px;
  }
  .board-toolbar {
    display: block;
  }
  .filter-tabs {
    gap: 0;
    justify-content: space-between;
    margin-bottom: 13px;
  }
  .filter-tabs button {
    font-size: 12px;
    padding: 8px 6px;
  }
  .filter-tabs button span {
    font-size: 10px;
  }
  .search-field.compact {
    width: 100%;
    margin-top: 12px;
  }
  .search-field.compact input {
    font-size: 14px;
    padding: 9px 0;
  }
  .loop-card {
    min-height: 270px;
  }
  .coverage-note span {
    display: block;
    font-size: 12px;
    line-height: 1.8;
  }
  .coverage-note span > svg {
    display: none;
  }
  .coverage-note span > strong {
    display: block;
  }
  .modal,
  .modal.wide {
    max-height: calc(100dvh - 20px);
    width: calc(100vw - 20px);
    border-radius: 13px;
  }
  .modal.drawer {
    width: 100vw;
    border-radius: 0;
    max-height: 100dvh;
  }
  .modal-header {
    padding: 17px 20px;
  }
  .modal-header h2 {
    font-size: 19px;
    line-height: 1.4;
  }
  .modal-body {
    padding: 20px;
  }
  .modal-footer {
    padding: 15px 20px;
  }
  .modal-footer > .muted {
    display: none;
  }
  .modal-footer .primary-button {
    width: 100%;
  }
  .sample-options {
    grid-template-columns: 1fr;
    gap: 9px;
  }
  .sample-button small {
    font-size: 12px;
  }
  .form-grid {
    gap: 12px;
  }
  input,
  textarea,
  select {
    font-size: 16px;
    min-width: 0;
  }
  input[type="date"] {
    font-size: 14px;
  }
  .form-grid label {
    min-width: 0;
  }
  .field-meta {
    flex-direction: column;
    gap: 3px;
    font-size: 11px;
  }
  .detail-title {
    font-size: 24px !important;
  }
  .source-evidence .text-button {
    font-size: 11px;
  }
  .source-evidence > div {
    font-size: 9px;
  }
  .tab-row {
    gap: 20px;
  }
  .tab-row > button {
    font-size: 13px;
  }
  .button-row .primary-button,
  .button-row .secondary-button {
    font-size: 13px;
    padding: 10px 12px;
  }
  .source-summary {
    align-items: flex-start;
  }
  .source-summary h2 {
    font-size: 17px;
  }
  .source-summary p {
    font-size: 12px;
  }
  .source-toolbar {
    display: block;
  }
  .source-toolbar select {
    width: 100%;
    margin-top: 12px;
  }
  .source-sentence {
    padding: 18px 16px;
    gap: 11px;
  }
  .sentence-number {
    width: 22px;
    font-size: 11px;
  }
  .sentence-label {
    font-size: 10px;
  }
  .sentence-body .verbatim {
    font-size: 15px;
  }
  .source-sentence .text-button {
    font-size: 12px;
  }
  .evidence-intro {
    padding: 22px;
    gap: 12px;
  }
  .evidence-intro h2 {
    font-size: 23px;
  }
  .model-recipe {
    font-size: 11px;
    gap: 8px;
  }
  .model-recipe > svg {
    width: 15px;
  }
  .metrics-row {
    padding: 0;
    grid-template-columns: 1fr;
  }
  .metrics-row > div {
    padding: 20px 24px;
    border-right: 0;
    border-bottom: 1px solid #e4eaf2;
  }
  .metrics-row strong {
    font-size: 40px;
  }
  .live-lab {
    padding: 21px;
  }
  .live-lab h2 {
    font-size: 22px;
  }
  .prediction-summary {
    gap: 9px;
  }
  .prediction-summary > strong {
    font-size: 13px;
  }
  .score-bars > div {
    grid-template-columns: 99px 1fr 40px;
    font-size: 12px;
    gap: 9px;
  }
  .limits-grid {
    grid-template-columns: 1fr;
    gap: 5px;
  }
  .limits-grid ul {
    font-size: 14px;
  }
  .brief-document {
    padding: 19px;
  }
  .brief-brand {
    font-size: 22px;
  }
  .brief-brand > span {
    display: block;
    margin: 5px 0 0;
  }
  .export-toolbar {
    gap: 7px;
  }
  .export-toolbar button {
    font-size: 12px;
    padding: 10px;
  }
  .reference-list a {
    padding: 17px;
  }
  .reference-list strong {
    font-size: 14px;
  }
  .reference-list small {
    font-size: 12px;
  }
  .welcome-state {
    padding: 28px 0 10px;
  }
  .welcome-state h1 {
    font-size: 31px;
  }
  .welcome-state > p {
    font-size: 16px;
  }
  .toast {
    font-size: 13px;
    width: calc(100vw - 32px);
    bottom: 16px;
  }
  .demo-footer {
    font-size: 11px;
  }
  .demo-footer .text-button {
    font-size: 11px;
  }
}
@media print {
  @page {
    margin: 16mm;
    size: A4;
  }
  body {
    background: white;
  }
  .app-shell > .sidebar,
  .app-shell > .main-shell,
  .toast,
  .no-print,
  .print-dialog .modal-header {
    display: none !important;
  }
  .print-dialog {
    display: block !important;
    position: static !important;
    border: 0 !important;
    box-shadow: none !important;
    width: 100% !important;
    height: auto !important;
    max-height: none !important;
    max-width: none !important;
    overflow: visible !important;
    margin: 0 !important;
    padding: 0 !important;
  }
  .print-dialog::backdrop {
    display: none;
  }
  .print-dialog .modal-body {
    padding: 0;
  }
  .brief-document {
    border: 0;
    margin: 0;
    padding: 0;
  }
  .brief-document p,
  .brief-item ul {
    font-size: 11pt;
    line-height: 1.6;
  }
  .brief-item h3 {
    font-size: 14pt;
  }
  .brief-item blockquote {
    font-size: 11pt;
    background: #f6f7f9;
  }
  .brief-document footer {
    font-size: 9pt;
  }
  .brief-brand {
    font-size: 24pt;
  }
  .app-shell {
    display: block;
  }
  html,
  body {
    height: auto !important;
    overflow: visible !important;
  }
  .modal-inner {
    overflow: visible;
  }
}

