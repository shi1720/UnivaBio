@import "tailwindcss" source(none);
@source "./";
@source "../components";
:root {
  --background: #f5f7fa;
  --foreground: #15253b;
  --card: #fff;
  --primary: #315bdb;
  --primary-foreground: #fff;
  --muted: #edf1f6;
  --muted-foreground: #627087;
  --border: #dfe5ee;
  --radius: 1rem;
  color-scheme: light;
}
* {
  box-sizing: border-box;
}
body {
  margin: 0;
  background: var(--background);
  color: var(--foreground);
  font-family: Arial, Helvetica, sans-serif;
  font-size: 16px;
  line-height: 1.5;
}
button,
a,
input,
textarea,
select {
  -webkit-tap-highlight-color: transparent;
}
button,
a {
  transition:
    background 0.18s,
    box-shadow 0.18s,
    transform 0.18s;
}
button {
  font: inherit;
  cursor: pointer;
}
a {
  color: inherit;
  text-decoration: none;
}
button:focus-visible,
a:focus-visible,
input:focus-visible,
textarea:focus-visible,
select:focus-visible {
  outline: 3px solid #5681f3;
  outline-offset: 4px;
}
button:disabled {
  opacity: 0.6;
  cursor: wait;
}
button svg {
  flex-shrink: 0;
}
.app-shell {
  display: flex;
  min-height: 100vh;
}
