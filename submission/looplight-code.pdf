/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
# Checkout-local execution profile and tool state; never publish them.
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/

# Unrelated sibling work in this shared workspace
/Amazon Developer Hackathon/
*.tsbuildinfo
/tmp/
__pycache__/
!/.env.example
/dayweave-handoff-guard/
/dayweave-submission-drafts/

endstream
