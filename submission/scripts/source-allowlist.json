{
  "schema": "looplight-code-inventory-policy-v1",
  "printed_exact_files": [
    "package.json",
    "tsconfig.json",
    "next.config.ts",
    "next-env.d.ts",
    "vite.config.ts",
    "eslint.config.mjs",
    "postcss.config.mjs",
    "drizzle.config.ts",
    "cloudflare-env.d.ts",
    "components.json",
    ".openai/hosting.json",
    ".gitignore",
    ".npmrc",
    ".env.example",
    "public/favicon.svg",
    "public/examples/anita-discharge.txt",
    "submission/scripts/source-allowlist.json",
    "wrangler.local.jsonc",
    ".github/workflows/ci.yml",
    "firebase.json",
    ".firebaserc",
    "firebase/config.json",
    "firebase/firestore.indexes.json",
    "tests/firebase/emulators.json",
    "tests/firebase/.gitignore"
  ],
  "printed_source_directories": [
    "app",
    "firebase",
    "lib",
    "tests",
    "db",
    "scripts",
    "submission/scripts",
    "submission/builders",
    "submission/video/builders",
    "build"
  ],
  "printed_source_extensions": [
    ".ts",
    ".tsx",
    ".mts",
    ".js",
    ".jsx",
    ".mjs",
    ".cjs",
    ".py",
    ".sh",
    ".css",
    ".sql",
    ".html",
    ".rules"
  ],
  "printed_globs": [
    "ml/**/*.py",
    "ml/**/*.ts",
    "ml/**/*.mts",
    "ml/**/*.mjs",
    "drizzle/*.sql",
    "ml/**/*.patch"
  ],
  "hash_only_globs": [
    "ml/**/*.json",
    "ml/**/*.md",
    "drizzle/meta/*.json",
    "package-lock.json",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "docs/**/*.md",
    "public/examples/*.pdf",
    "submission/assets/**/*",
    "submission/scripts/*.json",
    "submission/scripts/requirements*.txt",
    "submission/scripts/*.md",
    "tests/firebase/reports/*.json",
    "tests/firebase/*.md",
    "submission/code-walkthrough-and-judge-qa.md",
    "submission/builders/**/*.json",
    "submission/builders/assets/**/*",
    "submission/builders/**/requirements*.txt",
    "submission/builders/**/*.md",
    "submission/video/builders/**/*.json",
    "submission/video/builders/**/requirements*.txt",
    "submission/video/builders/**/*.md",
    "submission/video/builders/assets/**/*",
    "submission/video/README.md",
    "build/*.LICENSE",
    "components/**/*.tsx",
    "hooks/**/*.ts",
    "vendor/*.css",
    "vendor/*.LICENSE.md",
    "docs/images/**/*"
  ],
  "excluded_path_parts": [
    "node_modules",
    ".git",
    ".next",
    "dist",
    "tmp",
    ".wrangler",
    ".sites-runtime",
    ".vinext",
    "__pycache__",
    ".firebase",
    ".venv",
    "venv",
    ".agents",
    ".codex"
  ],
  "excluded_root_prefixes": [
    "Amazon Developer Hackathon",
    "dayweave"
  ],
  "exclusion_note": "No foreign projects, dependency trees, build outputs, real .env files, vendored PDF.js module/worker, credentials, or temporary runtime state. Firebase browser configuration is public application configuration, not a service-account credential. Current Firebase application/rules/configuration and tests are printed alongside retained historical implementation source. Inherited UI/hook scaffold, vendored CSS and upstream licenses are supplied as hash-listed exact attachments for complete builds; inclusion does not claim original authorship. Generated model/data/evaluation JSON, sanitized Firebase test reports, the dependency lockfile, selected supporting prose, and binary assets are hash-listed rather than printed. All printed and hash-listed files are embedded in the PDF as byte-exact attachments and included in the companion source ZIP. Inclusion does not assert that inherited runtime helpers were authored from scratch.",
  "required_printed_files": [
    "firebase.json",
    ".firebaserc",
    "firebase/config.json",
    "firebase/client.ts",
    "firebase/store.ts",
    "firebase/main.tsx",
    "firebase/vite.config.ts",
    "firebase/firestore.rules",
    "firebase/firestore.indexes.json",
    "lib/history.ts",
    "lib/snapshot.ts",
    "lib/drafts.ts",
    "tests/firebase/unit.test.mts",
    "tests/firebase/integration.mts",
    "tests/firebase/run-emulators.mjs",
    "tests/firebase/emulators.json",
    "scripts/sync-pdfjs.mjs",
    "submission/video/builders/build-thumbnail.py",
    "submission/video/builders/check_capture_timing.py",
    "submission/video/builders/verify_final_video.py",
    "build/sites-vite-plugin.ts"
  ]
}
