{
  "format": "Silent screenshot walkthrough. Real app captures with fictional records. Title cards explicitly describe hypotheses or synthetic evidence.",
  "scenes": [
    {
      "paragraph": 0,
      "title": "The next step, accounted for",
      "card": "A follow-up ledger\nfor the days after discharge.",
      "card_note": "Anita and Maya are fictional.\nThe coordination problem is real."
    },
    {
      "paragraph": 1,
      "title": "01 / Anita is home. Care is still unfinished.",
      "image": "walkthrough/desktop-board.png"
    },
    {
      "paragraph": 2,
      "title": "02 / Every action keeps its source",
      "image": "walkthrough/source-review.png",
