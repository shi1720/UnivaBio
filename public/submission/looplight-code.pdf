stream
name: Verify Looplight
on:
  push:
    branches: [main]
  pull_request:
permissions:
  contents: read
jobs:
  verify:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: "22"
          cache: npm
      - run: npm ci
      - run: npm run lint
      - run: npm run typecheck
      - run: npm test
      - run: npm run test:firebase:unit
      - run: npm run test:model
      - run: npm run build
      - run: npm audit --omit=dev
  firebase-emulators:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: "22"
          cache: npm
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "21"
      - run: npm ci
      - name: Exercise local Auth and Firestore rules without credentials
        run: npm run test:firebase:emulator
      - name: Retain sanitized emulator results
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: firebase-emulator-results
          path: tests/firebase/emulator-results-*.json
          if-no-files-found: ignore
          retention-days: 14
  historical-d1:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: "22"
          cache: npm
      - run: npm ci
      - run: npm run db:local
      - name: Retain historical local D1 and HTTP regression coverage
        shell: bash
        run: |
          npm run dev:sites > /tmp/looplight-dev.log 2>&1 &
          server_pid=$!
          trap 'kill "$server_pid" || true' EXIT
          for attempt in $(seq 1 60); do
            if curl --silent --fail http://localhost:5173/ > /dev/null; then break; fi
            sleep 1
          done
          npm run test:api

endstream
