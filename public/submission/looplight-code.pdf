const missingResult =
  /\b(?:results?|reports?|findings)\b[^;.!?\n]{0,90}?\b(?:has|have|is|are)\s+(?:still\s+)?not\s+(?:yet\s+)?(?:arrived|back|available|reached|returned|reported|finalized|finalised)\b/i;
