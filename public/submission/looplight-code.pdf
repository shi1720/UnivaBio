      "text": "The plan states that no additional testing or routine review is needed.",
      "label": "context",
      "tags": [
        "negation"
      ]
    },
    {
      "id": "eval-context-009",
      "text": "Your symptoms had settled by the time the discharge examination was done.",
      "label": "context",
      "tags": [
        "historical"
      ]
    },
    {
      "id": "eval-context-010",
      "text": "The next paragraph explains how to get a copy of this hospital letter.",
      "label": "context",
      "tags": [
        "administrative"
      ]
    }
  ]
}

