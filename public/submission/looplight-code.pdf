"""Original synthetic examples authored for Looplight; no patient information.

The held-out examples were authored independently of training phrasing. The split
is fixed before training. Labels describe sentence topics, not clinical truth.
"""
from pathlib import Path
import json

HERE = Path(__file__).parent
LABELS = ["follow_up", "pending_result", "medication", "safety", "context"]

TRAIN = {
"follow_up": [
"Book a follow-up appointment with your family doctor within seven days.",
"Please arrange a cardiology consultation next month.",
