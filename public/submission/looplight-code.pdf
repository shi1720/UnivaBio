    {
      "id": "train-safety-012",
      "text": "New confusion or extreme drowsiness requires urgent medical attention.",
      "label": "safety"
    },
    {
      "id": "train-safety-013",
      "text": "Contact urgent care today if the wound becomes hot, swollen, and more painful.",
      "label": "safety"
    },
    {
      "id": "train-safety-014",
      "text": "If you cannot keep fluids down, seek medical advice urgently.",
      "label": "safety"
    },
    {
      "id": "train-safety-015",
      "text": "Get emergency help if you have a seizure lasting longer than your care plan allows.",
      "label": "safety"
    },
    {
      "id": "train-safety-016",
      "text": "If symptoms suddenly become much worse, seek immediate medical assessment.",
      "label": "safety"
    },
    {
      "id": "train-safety-017",
      "text": "A new severe headache with neck stiffness needs urgent medical help.",
      "label": "safety"
    },
    {
      "id": "train-safety-018",
      "text": "Seek urgent care for severe abdominal pain that does not ease.",
      "label": "safety"
    },
    {
      "id": "train-safety-019",
      "text": "Call emergency services if you think someone is having a stroke.",
      "label": "safety"
    },
    {
      "id": "train-safety-020",
      "text": "If you feel at immediate risk of harming yourself, contact emergency support now.",
      "label": "safety"
    },
    {
      "id": "train-safety-021",
      "text": "Return promptly if your baby becomes unusually difficult to wake.",
      "label": "safety"
    },
    {
      "id": "train-safety-022",
      "text": "If you cough up a large amount of blood, go to the emergency department.",
      "label": "safety"
    },
    {
      "id": "train-safety-023",
      "text": "Do not drive yourself if you feel faint; request urgent help.",
      "label": "safety"
    },
    {
      "id": "train-safety-024",
      "text": "Seek same-day advice if the redness spreads beyond the marked area.",
      "label": "safety"
    },
    {
      "id": "train-safety-025",
      "text": "If you cannot pass urine and are in pain, seek urgent medical assessment.",
      "label": "safety"
    },
    {
      "id": "train-safety-026",
      "text": "Contact the maternity unit immediately for the warning symptoms in your care plan.",
      "label": "safety"
    },
    {
      "id": "train-safety-027",
      "text": "If your breathing worsens despite the prescribed plan, seek emergency care.",
      "label": "safety"
    },
    {
      "id": "train-safety-028",
      "text": "Call for urgent help if your child has signs of severe dehydration.",
      "label": "safety"
    },
    {
      "id": "train-safety-029",
      "text": "The discharge team advised returning immediately for severe pain or collapse.",
      "label": "safety"
    },
    {
      "id": "train-safety-030",
      "text": "Do not wait for a routine appointment if you develop sudden chest pain.",
      "label": "safety"
    },
    {
      "id": "train-safety-031",
      "text": "If the wound opens and bleeds heavily, seek emergency attention.",
      "label": "safety"
    },
    {
      "id": "train-safety-032",
      "text": "New facial drooping or trouble speaking requires emergency help.",
      "label": "safety"
    },
    {
      "id": "train-safety-033",
      "text": "Call your local emergency number for a serious allergic reaction.",
      "label": "safety"
    },
    {
      "id": "train-safety-034",
      "text": "If you are struggling to stay awake, ask someone to get urgent help.",
      "label": "safety"
    },
    {
      "id": "train-safety-035",
      "text": "Seek urgent advice if the symptoms described as red flags occur.",
      "label": "safety"
    },
    {
      "id": "train-safety-036",
      "text": "If severe breathlessness returns, call emergency services and do not wait for the clinic to reply.",
      "label": "safety"
    },
    {
      "id": "train-safety-037",
      "text": "Continue the prescribed tablets, but seek immediate help if your tongue swells.",
      "label": "safety"
    },
    {
      "id": "train-safety-038",
      "text": "Book your routine review and seek urgent care if severe chest pain develops.",
      "label": "safety"
    },
    {
      "id": "train-safety-039",
      "text": "Get emergency help for uncontrolled bleeding even if one form says to wait until morning.",
      "label": "safety"
    },
    {
      "id": "train-safety-040",
      "text": "Call the urgent advice line today if you develop a fever after the procedure.",
      "label": "safety"
    },
    {
      "id": "train-safety-041",
      "text": "If the leg becomes suddenly cold and painful, seek immediate medical attention.",
      "label": "safety"
    },
    {
      "id": "train-safety-042",
      "text": "Return to urgent care if you have a new fever and the wound is worsening.",
      "label": "safety"
    },
    {
      "id": "train-safety-043",
      "text": "Do not ignore a sudden change in consciousness; call emergency services.",
      "label": "safety"
    },
    {
      "id": "train-safety-044",
      "text": "If you have severe difficulty breathing, get emergency help rather than taking an extra tablet.",
      "label": "safety"
    },
    {
      "id": "train-safety-045",
      "text": "Seek urgent medical review if your symptoms meet the warning signs listed in your discharge instructions.",
      "label": "safety"
    },
